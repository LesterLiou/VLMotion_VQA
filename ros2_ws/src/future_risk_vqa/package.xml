<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>future_risk_vqa</name>
  <version>0.1.0</version>
  <description>Future-oriented person risk pipeline using SAM3, geometry, VLM, and rules.</description>
  <maintainer email="hrclab.nthu@gmail.com">hrc</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
